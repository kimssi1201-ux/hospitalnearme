# Cloudflare Pages environment variables
# Store real keys in Cloudflare Pages > Settings > Environment variables, never in GitHub.

# Seoul Open Data cultural event API
SEOUL_OPEN_API_KEY=your_seoul_open_api_key_here

# Korea Tourism Organization TourAPI
TOUR_API_KEY=your_tour_api_key_here

# Korea Tourism Organization PhotoGalleryService1 (keyword photo search).
# Separate data.go.kr application/key from TOUR_API_KEY above. Optional -
# used to supplement detailImage2 when a festival has too few photos; the
# daily refresh script silently skips it if unset.
PHOTO_GALLERY_API_KEY=your_photo_gallery_api_key_here

# Seoul public parking API
SEOUL_PARKING_API_KEY=your_seoul_parking_api_key_here

# OpenAI API for supplemental festival guide text
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.2

# MyRealTrip API
MYREALTRIP_API_KEY=your_myrealtrip_api_key_here
MYREALTRIP_API_ENDPOINT=tna-categories

# Coupang Partners API
COUPANG_ACCESS_KEY=your_coupang_access_key_here
COUPANG_SECRET_KEY=your_coupang_secret_key_here
COUPANG_TRACKING_CODE=your_tracking_code_here
