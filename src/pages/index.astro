---
import BaseLayout from "../layouts/BaseLayout.astro";
import CampaignHero from "../components/CampaignHero.astro";
import CategoryNav from "../components/CategoryNav.astro";
import CampaignGrid from "../components/CampaignGrid.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCategories } from "../lib/categories.mjs";
import { getActiveCampaigns, getFeaturedCampaigns, getLatestCampaigns, getPopularCampaigns, getCampaignsByCategory } from "../lib/campaigns.mjs";
import { absoluteUrl, webPageSchema } from "../lib/seo.mjs";
import { getEditorialPosts, getFestivalItems } from "../lib/legacy-content.mjs";

const categories = await getCategories();
const activeCampaigns = await getActiveCampaigns();
const featured = (await getFeaturedCampaigns()).length ? await getFeaturedCampaigns() : activeCampaigns.slice(0, 5);
const popular = await getPopularCampaigns();
const latest = await getLatestCampaigns();
const freeConsulting = activeCampaigns.filter((campaign) => /무료|상담|초대|신청/.test(`${campaign.title} ${campaign.badge} ${campaign.benefit} ${campaign.ctaText}`)).slice(0, 6);
const categorySections = await Promise.all(categories.map(async (category) => ({
  category,
  campaigns: (await getCampaignsByCategory(category.slug)).slice(0, 4)
})));
const articles = await getEditorialPosts(4);
const festivals = await getFestivalItems(6);
const searchItems = activeCampaigns.map((campaign) => ({
  title: campaign.title,
  category: campaign.category,
  description: campaign.description,
  url: `/event/${campaign.slug}/`
}));
const seo = {
  title: "VIEW1 | 이벤트 정보 포털",
  description: "상담, 무료초대권, 생활 혜택 이벤트와 기존 대한축제뉴스의 축제·여행 정보를 함께 확인하는 데이터 기반 이벤트 포털입니다.",
  canonical: absoluteUrl("/"),
  structuredData: webPageSchema({
    title: "VIEW1 이벤트 정보 포털",
    description: "데이터 기반 CPA 이벤트와 축제·여행 정보 포털",
    url: absoluteUrl("/")
  })
};
---

<BaseLayout {...seo}>
  <main class="portal-main">
    <CampaignHero campaigns={featured} categories={categories} />
    <CategoryNav categories={categories} />

    <section class="campaign-search" aria-labelledby="campaign-search-title">
      <div class="section-heading">
        <p>Search</p>
        <h2 id="campaign-search-title">이벤트 검색</h2>
        <span>캠페인명, 분야, 혜택 키워드로 현재 활성 이벤트를 찾습니다.</span>
      </div>
      <form class="campaign-search__form" data-campaign-search-form>
        <label class="sr-only" for="campaignSearchInput">이벤트 검색어</label>
        <input id="campaignSearchInput" type="search" placeholder="예: 웨딩, 건강, 무료 상담" autocomplete="off" data-campaign-search-input />
        <button type="submit">검색</button>
      </form>
      <div class="campaign-search__results" data-campaign-search-results aria-live="polite"></div>
    </section>

    <CampaignGrid id="popular" title="지금 인기 있는 이벤트" kicker="Popular" description="popular:true 캠페인을 우선순위 순으로 자동 노출합니다." campaigns={popular} categories={categories} />
    <CampaignGrid id="free-consulting" title="무료 상담 이벤트" kicker="Free" description="무료, 상담, 초대권 성격의 활성 이벤트를 자동으로 묶습니다." campaigns={freeConsulting} categories={categories} />
    <CampaignGrid id="latest" title="신규 이벤트" kicker="New" description="startDate 기준 최신 이벤트가 자동으로 올라옵니다." campaigns={latest.slice(0, 6)} categories={categories} />

    {categorySections.map(({ category, campaigns }) => (
      <CampaignGrid
        id={`category-${category.slug}`}
        title={`${category.name} 이벤트`}
        kicker="Category"
        description={category.description}
        campaigns={campaigns}
        categories={categories}
        emptyText={`${category.name} 분야의 활성 이벤트가 없습니다.`}
      />
    ))}

    <section class="content-section" id="articles" aria-labelledby="articles-title">
      <div class="section-heading">
        <p>Info</p>
        <h2 id="articles-title">생활/정보 콘텐츠</h2>
        <span>기존 대한축제뉴스 기사 URL은 유지하면서 하단 정보 영역으로 보존합니다.</span>
      </div>
      <div class="article-grid">
        {articles.map((item) => <ArticleCard item={item} />)}
      </div>
      <a class="text-link" href="/articles/">전체 기사 보기</a>
    </section>

    <section class="content-section" id="festivals" aria-labelledby="festivals-title">
      <div class="section-heading">
        <p>Festival</p>
        <h2 id="festivals-title">기존 축제·여행 콘텐츠</h2>
        <span>전국 축제 자동 갱신 데이터와 TourAPI 기반 상세 URL을 계속 유지합니다.</span>
      </div>
      <div class="article-grid article-grid--dense">
        {festivals.map((item) => <ArticleCard item={item} />)}
      </div>
      <a class="text-link" href="/festival/">축제 정보 보기</a>
    </section>
  </main>

  <script define:vars={{ searchItems }}>
    const form = document.querySelector("[data-campaign-search-form]");
    const input = document.querySelector("[data-campaign-search-input]");
    const results = document.querySelector("[data-campaign-search-results]");
    const escapeHtml = (value) => String(value || "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[char]));
    const render = (items, query) => {
      if (!results) return;
      if (!query) {
        results.innerHTML = "";
        return;
      }
      if (!items.length) {
        results.innerHTML = '<p class="empty-inline">일치하는 활성 이벤트가 없습니다.</p>';
        return;
      }
      results.innerHTML = items.slice(0, 8).map((item) => `<a href="${escapeHtml(item.url)}"><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.description)}</span></a>`).join("");
    };
    const search = () => {
      const query = String(input?.value || "").trim().toLowerCase();
      const matches = query
        ? searchItems.filter((item) => `${item.title} ${item.category} ${item.description}`.toLowerCase().includes(query))
        : [];
      render(matches, query);
    };
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      search();
    });
    input?.addEventListener("input", search);
  </script>
</BaseLayout>
